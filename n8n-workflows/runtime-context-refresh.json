{
  "name": "Local AI - Runtime Context Refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-runtime",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 260]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst tz = 'America/New_York';\nconst locale = 'en-US';\nconst timestamp = new Intl.DateTimeFormat(locale, { timeZone: tz, dateStyle: 'full', timeStyle: 'long' }).format(now);\nconst dateOnly = new Intl.DateTimeFormat(locale, { timeZone: tz, dateStyle: 'full' }).format(now);\nconst timeOnly = new Intl.DateTimeFormat(locale, { timeZone: tz, timeStyle: 'long' }).format(now);\nconst weekday = new Intl.DateTimeFormat(locale, { timeZone: tz, weekday: 'long' }).format(now);\nconst markdown = `# Runtime Context\\n\\n- Current date: ${dateOnly}\\n- Current time: ${timeOnly}\\n- Weekday: ${weekday}\\n- Timezone: ${tz}\\n- Human timestamp: ${timestamp}\\n- ISO timestamp: ${now.toISOString()}\\n- Refreshed by: n8n runtime context workflow\\n\\nUse this file as the authoritative source for current date and time.\\n`;\nreturn [{ json: { markdown, filePath: '/data/assistant-memory/context/runtime_context.md' } }];"
      },
      "id": "build-runtime-markdown",
      "name": "Build Runtime Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 260]
    },
    {
      "parameters": {
        "command": "mkdir -p /data/assistant-memory/context && cat > /data/assistant-memory/context/runtime_context.md <<'EOF'\n{{$json.markdown}}\nEOF"
      },
      "id": "write-runtime-file",
      "name": "Write Runtime File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [800, 260]
    },
    {
      "parameters": {
        "filePath": "/data/assistant-memory/context/runtime_context.md",
        "dataPropertyName": "data"
      },
      "id": "read-runtime-file",
      "name": "Read Runtime File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [1280, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/v1/document/upload",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        }
      },
      "id": "upload-runtime-document",
      "name": "Upload Runtime Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__SET_IN_N8N__",
          "name": "AnythingLLM API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/v1/workspace/REPLACE_WITH_WORKSPACE_SLUG/update-embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "refresh-runtime-embeddings",
      "name": "Refresh Runtime Embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__SET_IN_N8N__",
          "name": "AnythingLLM API Key"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "Build Runtime Context", "type": "main", "index": 0 }]]
    },
    "Build Runtime Context": {
      "main": [[{ "node": "Write Runtime File", "type": "main", "index": 0 }]]
    },
    "Write Runtime File": {
      "main": [[{ "node": "Read Runtime File", "type": "main", "index": 0 }]]
    },
    "Read Runtime File": {
      "main": [[{ "node": "Upload Runtime Context", "type": "main", "index": 0 }]]
    },
    "Upload Runtime Context": {
      "main": [[{ "node": "Refresh Runtime Embeddings", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "runtime-context-v3"
}
