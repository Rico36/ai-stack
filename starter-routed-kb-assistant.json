      "parameters": {
        "jsCode": "const raw = $json.text || $json.response || $json.content || $json.message || JSON.stringify($json);\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  parsed = { intent: 'search', document_name: '', reason_short: 'fallback parse' };\n}\nreturn [{ json: { ...$json, intent: parsed.intent || 'search', document_name: parsed.document_name || '', reason_short: parsed.reason_short || '' } }];"
      },
