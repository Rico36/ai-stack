      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length) {\n  return [{ json: { found: false, error: 'No matching document found', question: $json.question, document_name: $json.document_name || $json.extracted_document_name || '' } }];\n}\nconst chosen = rows[0];\nconst raw = chosen.file_id || '';\nconst normalized_file_id = raw.startsWith('/files/') ? raw : `/files/${raw}`;\nreturn [{ json: { ...$json, ...chosen, found: true, normalized_file_id } }];"
      },
