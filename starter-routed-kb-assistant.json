      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT file_id, file_name, title, sheet_name\nFROM document_metadata\nWHERE LOWER(COALESCE(file_name, '')) LIKE LOWER('%' || $1 || '%')\n   OR LOWER(COALESCE(title, '')) LIKE LOWER('%' || $1 || '%')\nORDER BY\n  CASE\n    WHEN LOWER(COALESCE(file_name, '')) = LOWER($1) THEN 1\n    WHEN LOWER(COALESCE(title, '')) = LOWER($1) THEN 2\n    ELSE 3\n  END,\n  COALESCE(file_name, title, file_id)\nLIMIT 5;",
        "options": {
          "queryReplacement": "={{ $json.document_name || $json.extracted_document_name || $json.question }}"
        }
      },
