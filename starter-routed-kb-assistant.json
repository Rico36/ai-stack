    {
      "parameters": {
        "jsCode": "const q = String($json.question || '').trim();\nconst lower = q.toLowerCase();\nconst hasFilenameMatch = q.match(/\\b[\\w() .\\-]+\\.(pdf|docx|doc|txt|csv|xlsx|xls)\\b/i);\nconst filename = hasFilenameMatch ? hasFilenameMatch[0].trim() : '';\nconst direct = /^(hi|hello|hey|good morning|good afternoon|good evening)$/i.test(q) || /what are you\\??|how can you help\\??/i.test(lower);\nconst asksList = /(list|show|what).*(files|documents)/i.test(lower) || /(files|documents).*(available|in the knowledgebase)/i.test(lower);\nconst tabular = /\\b(csv|excel|xlsx|xls|spreadsheet|rows|columns|sheet|dataset|table)\\b/i.test(lower);\nlet intent = 'search';\nif (direct) intent = 'direct';\nelse if (asksList) intent = 'list';\nelse if (tabular) intent = 'table';\nelse if (filename) intent = 'document';\nreturn [{ json: { ...$json, question_lower: lower, heuristic_intent: intent, extracted_document_name: filename, direct, asksList, tabular, hasFilename: !!filename } }];"
      },
      "id": "heuristic-router-1",
      "name": "Heuristic Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
