    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, sheet_name\nFROM document_metadata\nWHERE LOWER(COALESCE(id, '')) LIKE LOWER('%' || $1 || '%')\n   OR LOWER(COALESCE(title, '')) LIKE LOWER('%' || $1 || '%')\nORDER BY\n  CASE\n    WHEN LOWER(COALESCE(title, '')) = LOWER($1) THEN 1\n    WHEN LOWER(COALESCE(id, '')) = LOWER($1) THEN 2\n    WHEN LOWER(COALESCE(title, '')) LIKE LOWER($1 || '%') THEN 3\n    WHEN LOWER(COALESCE(id, '')) LIKE LOWER($1 || '%') THEN 4\n    ELSE 5\n  END,\n  COALESCE(title, id)\nLIMIT 5;",
        "options": {
          "queryReplacement": "={{ $json.document_name || $json.extracted_document_name || $json.question }}"
        }
      },
