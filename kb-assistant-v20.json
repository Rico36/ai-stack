        "jsCode": "const question = $('Finalize Intent').item.json.question || '';\nconst document_name = $('Normalize file_id').item.json.title || $('Normalize file_id').item.json.id || 'Unknown';\nconst rows = $input.all().map(i => i.json);\nconst document_text = rows.map(r => r.document_text || '').join('\\n');\nreturn [{ json: { question, document_name, document_text } }];"
      },
