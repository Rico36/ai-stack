    {
      "parameters": {
        "jsCode": "const question = $('Finalize Intent').item.json.question || '';\nconst rows = $input.all().map(i => i.json);\nconst context = rows.map((r, idx) => {\n  const doc = r.document || r;\n  const meta = doc.metadata || r.metadata || {};\n  const source = meta.file_title || meta.file_id || 'Unknown';\n  const text = doc.pageContent || r.pageContent || r.text || JSON.stringify(r);\n  return `[${idx + 1}] (${source}):\\n${text}`;\n}).join('\\n\\n');\nreturn [{ json: { question, context, chunk_count: rows.length } }];"
      },
