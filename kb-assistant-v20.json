    {
      "parameters": {
        "jsCode": "const question = $('Finalize Intent').item.json.question || '';\nconst rows = $input.all().map(i => i.json);\nconst docList = rows.map(r => {\n  const name = r.title || r.id || 'Unknown';\n  const sheet = r.sheet_name && r.sheet_name !== '[empty]' ? ` (Sheet: ${r.sheet_name})` : '';\n  return `- ${name}${sheet}`;\n}).join('\\n');\nreturn [{ json: { question, document_list: docList, document_count: rows.length } }];"
      },
