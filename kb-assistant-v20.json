      "parameters": {
        "messages": {
          "messageValues": [
            {
              "message": "Classify the user message into one intent. Reply with ONLY a JSON object, nothing else.\n\nIntents:\n- direct: greeting or asking what you can do\n- list: asking to list or show available files/documents\n- search: asking about a topic, policy, concept, or guidance\n- document: asking about a specific named file (e.g. mentions .pdf, .docx)\n- table: asking about spreadsheet rows, columns, CSV, or Excel data\n\nIf unsure, use search.\n\nReply format (JSON only, no explanation):\n{\"intent\": \"search\", \"document_name\": \"\", \"reason_short\": \"topic question\"}",
              "type": "SystemMessagePromptTemplate"
            }
          ]
        },
        "promptType": "define",
        "text": "={{ $json.question }}\n/no_think",
        "hasOutputParser": false,
        "options": {}
      },
