      "parameters": {
        "jsCode": "const question = $('Finalize Intent').item.json.question || '';\nconst rows = $input.all().map(i => i.json);\nif (!rows.length) {\n  return [{ json: { found: false, error: 'No matching document found', question, document_name: $('Finalize Intent').item.json.document_name || '' } }];\n}\nconst chosen = rows[0];\nconst doc_id = chosen.id || '';\nconst doc_title = chosen.title || '';\nconst doc_sheet = chosen.sheet_name || '';\nreturn [{ json: { id: doc_id, title: doc_title, sheet_name: doc_sheet, question, found: true, document_name: doc_title || doc_id } }];"
      },
