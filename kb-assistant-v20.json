    {
      "parameters": {
        "jsCode": "// chainLlm outputs in $json.response or $json.text, but drops all original fields.\n// We need to recover the question from the Set Question node.\nconst question = $('Set Question').item.json.question || '';\nconst raw = String($json.response || $json.text || $json.content || $json.message || '').trim();\n\nif (!raw || raw.length < 3) {\n  return [{ json: { question, intent: 'search', document_name: '', reason_short: 'empty LLM response' } }];\n}\n\nlet parsed = null;\n\n// Try 1: Direct JSON parse\ntry { parsed = JSON.parse(raw); } catch(e) {}\n\n// Try 2: Strip markdown code blocks\nif (!parsed) {\n  try {\n    const cleaned = raw.replace(/```json\\s*/gi, '').replace(/```\\s*/gi, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch(e) {}\n}\n\n// Try 3: Extract first JSON object\nif (!parsed) {\n  const match = raw.match(/\\{[\\s\\S]*?\\}/);\n  if (match) { try { parsed = JSON.parse(match[0]); } catch(e) {} }\n}\n\n// Try 4: Regex extract intent value\nif (!parsed) {\n  const intentMatch = raw.match(/[\"']?intent[\"']?\\s*[:=]\\s*[\"']?(direct|list|search|document|table)[\"']?/i);\n  if (intentMatch) {\n    parsed = { intent: intentMatch[1].toLowerCase(), document_name: '', reason_short: 'regex extracted' };\n  }\n}\n\n// Try 5: Bare intent word\nif (!parsed) {\n  const lower = raw.toLowerCase().trim();\n  if (['direct','list','search','document','table'].includes(lower)) {\n    parsed = { intent: lower, document_name: '', reason_short: 'bare intent' };\n  }\n}\n\n// Final fallback\nif (!parsed) {\n  parsed = { intent: 'search', document_name: '', reason_short: 'parse failed' };\n}\n\nreturn [{ json: { question, intent: parsed.intent || 'search', document_name: parsed.document_name || '', reason_short: parsed.reason_short || '' } }];"
      },
