      "id": "intent-classifier-1",
      "name": "Intent Classifier LLM",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -870,
        580
      ],
      "credentials": {
