# Copy this file to .env and replace placeholder values where needed.

N8N_ENCRYPTION_KEY=<replace_me_with_a_long_random_secret>
N8N_USER_MANAGEMENT_JWT_SECRET=<replace_me_with_a_long_random_secret>

TZ=America/New_York

POSTGRES_USER=root
POSTGRES_PASSWORD=<replace_me_with_a_secure_password>
POSTGRES_DB=n8n

N8N_DB_USER=n8napp
N8N_DB_PASSWORD=<replace_me_with_a_secure_password>

PGADMIN_DEFAULT_EMAIL=<replace_me_with_your_email_address>
PGADMIN_DEFAULT_PASSWORD=<replace_me_with_a_secure_password>

N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

WEBUI_SECRET_KEY=<replace_me_with_a_long_random_secret>

SEARXNG_HOSTNAME=localhost

# Use an absolute Windows path in your real .env when the memory folder lives outside this repo.
# Example:
# LOCAL_AI_DATA_ROOT=D:/Local AI/local-ai-data/assistant-memory
LOCAL_AI_DATA_ROOT=./local-ai-data/assistant-memory

# These values are still passed into containers by compose, but the imported n8n workflow JSON
# files currently use node-level configuration for the same behavior. Treat this section as
# stack-level defaults or future compatibility, not as the source of truth for workflow behavior.
MEMORY_CAPTURE_TOKEN=<replace_me_with_a_long_random_secret>
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_SUMMARY_MODEL=qwen3:14b
WORLD_CONTEXT_MAX_ITEMS=12
WORLD_CONTEXT_LOOKBACK_DAYS=2

ANYTHINGLLM_API_BASE=http://host.docker.internal:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_SLUG=
ANYTHINGLLM_UPLOAD_FOLDER=assistant-memory
ANYTHINGLLM_SYNC_RUNTIME_CONTEXT=false

N8N_MEMORY_WEBHOOK_URL=http://n8n:5678/webhook/local-ai/memory-capture
MEMORY_BRIDGE_MAX_NOTE_LENGTH=4000
